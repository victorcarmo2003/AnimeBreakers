{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-comments.js\"",
            "timeout": 10,
            "statusMessage": "Checando comentários no código"
          }
        ]
      }
    ]
  }
}
