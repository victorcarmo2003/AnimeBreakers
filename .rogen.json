{
	"source": [
		"src"
	],
	"luau": {
		"output": "default.project.json",
		"build": "src"
	},
	"project": {
		"name": "ModuxTemplate",
		"tree": {
			"$className": "DataModel",
			"ReplicatedStorage": {
				"Packages": {
					"$path": "Packages"
				},
				"DevPackages": {
					"$path": "DevPackages"
				},
				"Assets": {
					"$className": "Folder",
					"Characters": {
						"$path": "assets/roblox/Characters"
					},
					"Effects": {
						"$path": "assets/roblox/Effects"
					}
				}
			},
			"Workspace": {
				"Map": {
					"$path": "assets/roblox/DevMap.rbxm"
				}
			},
			"ServerScriptService": {
				"ServerPackages": {
					"$path": "ServerPackages"
				}
			}
		}
	},
	"globIgnorePaths": [
		"**/*.md"
	]
}
